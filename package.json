{
  "name": "trinca-oculta",
  "version": "1.0.0",
  "private": true,
  "description": "Trinca Oculta — jogo de dedução (PWA estático para GitHub Pages)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/app.css -o ./css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/app.css -o ./css/app.css --watch",
    "serve": "npx --yes http-server -c-1 -p 8080 ."
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
